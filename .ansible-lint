---
profile: production

# Exclude files not meant to be linted directly
exclude_paths:
  - .github/
  # stand-ins named like the real dependency roles (with a dot) so they shadow them in molecule
  - molecule/shared/roles/

# Skip rules that don't apply to this role
skip_list:
  - yaml[truthy]          # boolean style is a matter of preference
  - var-naming[pattern]   # role intentionally uses UPPER_CASE variable names (breaking to rename)
